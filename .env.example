# Telegram
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here
ADMIN_IDS=123456789,987654321

# MongoDB (Railway MongoDB plugin or Atlas)
MONGODB_URL=mongodb://user:pass@host:27017
MONGODB_DB=yueying

# Redis (optional, for rate limit & session cache)
REDIS_URL=redis://default:pass@host:6379

# AI (optional, for matchmaker & authenticity)
# OpenAI-compatible endpoint, e.g. OpenAI / Grok / Qwen / GLM
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Mini App
WEBAPP_URL=https://your-domain.railway.app/miniapp
WEBHOOK_URL=
WEBHOOK_SECRET=

# Runtime
ENV=production
LOG_LEVEL=INFO
