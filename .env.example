# Telegram
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here
ADMIN_IDS=123456789,987654321
# 可选：媒体上传落盘会话（未设则用第一个 ADMIN_ID）
# STORAGE_CHAT_ID=-100xxxxxxxxxx

# PostgreSQL (Railway Postgres plugin or external)
# 例: postgresql+asyncpg://user:pass@host:5432/railway
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/yueying

# Redis（推荐生产配置；Railway → New → Database → Redis，再引用 REDIS_URL）
# 未设置时防刷回退进程内存并打警告日志（多实例不共享）
REDIS_URL=redis://default:password@hostname:6379

# 会话消息保留：结束后再过多少小时清理 SessionMessage 正文/行（默认 24）
MESSAGE_RETENTION_HOURS=24

# Webhook（生产必填；本地可空走 polling 调试）
# Railway 公网域名，如 https://yycj-production.up.railway.app
WEBHOOK_HOST=https://your-app.up.railway.app
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change-me-to-random-string

# Mini App：指向本服务静态页（须 HTTPS）。例：https://your-app.up.railway.app/app
# 配置后左下角 Menu Button「首页」打开 Mini App（无底部 ReplyKeyboard）
WEBAPP_URL=https://your-app.up.railway.app/app

# Runtime
ENV=production
LOG_LEVEL=INFO
PORT=8080
