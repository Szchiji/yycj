# 月影车姬 staging 环境示例（无真实 secret）。
# 这不是一份可以复制后就宣称「已完全隔离」的配置。
# 仅设置 ENV=staging 不足，启动前必须同时满足下列显式声明与离线校验。
# 切勿把本文件填入生产 token、生产 DATABASE_URL / REDIS_URL 或生产域名。

ENV=staging
STAGING_ISOLATION=1
STAGING_CONFIRMED_ISOLATED=1
STAGING_DB_IS_ISOLATED=1
STAGING_DATA_IS_SAMPLE=1

# Redis：二选一。独立测试实例，或明确不用 Redis（内存回退）。
STAGING_REDIS_IS_ISOLATED=1
# STAGING_REDIS_UNUSED=1
# REDIS_URL=

# 专用测试机器人。STAGING_EXPECTED_BOT_ID 必须与 BOT_TOKEN 冒号前的数字 id 一致。
# 不要填生产 token，也不要读取生产 token 来「对照」id。
# STAGING_EXPECTED_BOT_USERNAME 仅供操作者备忘，启动门禁不会调用 getMe 验证。
STAGING_EXPECTED_BOT_ID=000000000
# STAGING_EXPECTED_BOT_USERNAME=your_test_bot
BOT_TOKEN=000000000:replace-with-dedicated-TEST-bot-token
ADMIN_IDS=000000000

# 必须是独立测试库 / 独立 Redis，禁止复用生产连接串。
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/yycj_staging
REDIS_URL=redis://default:PASSWORD@HOST:6379

# 必须是该测试环境自己的 HTTPS 域名，不能是已知生产域名。
WEBHOOK_HOST=https://your-staging-host.example
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=replace-with-random-staging-secret
WEBAPP_URL=https://your-staging-host.example/app

LOG_LEVEL=INFO
PORT=8080

# 可选：补充其它已知生产主机或旧 Railway 标识（逗号分隔）。
# STAGING_BLOCKED_HOSTS=
# STAGING_BLOCKED_RAILWAY_ENV_IDS=
# STAGING_BLOCKED_RAILWAY_SERVICE_IDS=

# staging 默认全部关闭，需人工确认后再打开：
# STAGING_ENABLE_BOT_HOOKS=1          # setWebhook / menu / commands / deleteWebhook / 启动时 getMe
# STAGING_ENABLE_TELEGRAM_JOBS=1      # 到期提醒、班次提醒、频道目录、优惠帖、标签同步、审核补发
# STAGING_ENABLE_DB_JOBS=1            # 过期资料/会话清理、价格回填
# STAGING_ENABLE_DEMO_PURGE=1         # 启动时清理标题含「演示」的资料
# STAGING_ALLOW_TEST_CHANNELS=1       # 仅当库内频道确实是测试频道时再打开；默认要求频道为空
